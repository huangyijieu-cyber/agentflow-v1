# Copy to /home/ma-user/work/code-rl/cache/search-service.env; chmod 600.
SEARCH_SERVICE_TOKEN=replace-with-a-random-shared-token
SEARCH_CACHE_DIR=/home/ma-user/work/code-rl/cache
SEARCH_SERVICE_HOST=127.0.0.1
SEARCH_SERVICE_PORT=8091
SEARCH_SERVICE_USE_PROXY=1
# Only the development server needs the Yibu key.
YIBU_BRAVE_API_KEY=replace-with-your-key
SEARCH_WIKI_RPM=150
SEARCH_WIKI_CONCURRENCY=3
SEARCH_SERVICE_WORKERS=16
SEARCH_SERVICE_QUEUE_SIZE=128
SEARCH_SERVICE_REQUEST_TIMEOUT=120
SEARCH_CACHE_MAX_BYTES=2147483648
