# Copy to train-roma/search-cache.local.env; this file is NOT a secret.
# SSH access is ssh://ma-user@7.150.11.99:31753. 31753 is not an HTTP port.
# For direct intranet access, replace this with the reachable service HTTP URL.
SEARCH_CACHE_BASE_URL=http://127.0.0.1:8091
SEARCH_CACHE_TOKEN=replace-with-the-same-token-as-the-service
SEARCH_CACHE_ENABLED=1
SEARCH_CACHE_AUTO_START=1
SEARCH_CACHE_AUTO_TUNNEL=1
SEARCH_CACHE_SSH_TARGET=ma-user@7.150.11.99
SEARCH_CACHE_SSH_PORT=31753
# Actual repository root on the development server (not the data directory).
SEARCH_CACHE_REMOTE_REPO_DIR=/home/ma-user/work/code-rl
SEARCH_CACHE_DIR=/home/ma-user/work/code-rl/cache
SEARCH_SERVICE_PORT=8091
SEARCH_SERVICE_STARTUP_TIMEOUT=90
SEARCH_CACHE_BOOTSTRAP_TIMEOUT_SECONDS=180
SEARCH_CACHE_CONNECT_TIMEOUT_SECONDS=5
SEARCH_CACHE_READ_TIMEOUT_SECONDS=600
